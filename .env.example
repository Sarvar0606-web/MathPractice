# Telegramdan @BotFather orqali olingan bot tokeni
BOT_TOKEN=123456789:AAExampleTokenHere

# Admin huquqiga ega Telegram foydalanuvchi(lar)ning ID raqami(lari).
# Bir nechta bo'lsa vergul bilan ajrating: 111111,222222
ADMIN_IDS=111111111

# Mini App joylashgan DOIMIY HTTPS manzil.
# Masalan: https://sizningusername.pythonanywhere.com
WEBAPP_URL=https://your-domain.example.com

# Telegram webhook manzilidagi maxfiy qism VA Telegram yuboradigan maxfiy
# tokenni tekshirish uchun ishlatiladi. O'zingiz o'ylab topgan, taxmin
# qilib bo'lmaydigan tasodifiy matn kiriting (harf+raqam, bo'sh joysiz).
WEBHOOK_SECRET=mening-tasodifiy-maxfiy-matnim-12345

# (Ixtiyoriy) Botning username'i (@ belgisiz) — "Do'stni taklif qilish"
# bo'limida to'liq https://t.me/<username>?start=ref_XXXX havolasini
# tuzish uchun ishlatiladi. Bo'sh qoldirilsa, faqat referral kodi ko'rsatiladi.
BOT_USERNAME=

# Ishlab chiqish (development) rejimida Telegram initData tekshiruvini
# o'chirib turish uchun 1 qiling. Productionda albatta 0 bo'lsin!
DEV_SKIP_AUTH=0

# Flask serverni qaysi host/port'da ishga tushirish (faqat lokal test uchun;
# PythonAnywhere buni o'zi boshqaradi)
HOST=0.0.0.0
PORT=8080
